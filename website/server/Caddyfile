# ASKODOX website server. Static files built by build.py at container start.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv/site
	encode zstd gzip

	# www -> apex (only when www.askodox.com is attached to this service)
	@www host www.askodox.com
	redir @www https://askodox.com{uri} 308

	handle /health {
		respond "ok" 200
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# CSP header and /go/<slug> partner redirects (generated from config)
	import /srv/generated.caddy

	# Customer web chat: the SAME ASKODOX backend (assistant, discovery,
	# Universal Advisor) served on askodox.com -- no second chat engine.
	# Only these paths are forwarded; the client IP travels in
	# X-Forwarded-For so the backend's per-client rate limits still apply.
	@askodox_chat path /chat /api/in-app/assistant /deals/discover /api/advisor/next /content /api/content
	handle @askodox_chat {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		header -Cache-Control
		reverse_proxy {$ASKODOX_BACKEND_URL:https://podx-ai-connect-production-3279.up.railway.app} {
			header_up Host {upstream_hostport}
		}
	}

	# ASKODOX product pages (owner 2026-11-20): Facebook / Instagram / YouTube links open ASKODOX first
	# (/p/<id>, counted /p/<id>/buy -> the store) and /shop is the one profile link. Same backend.
	# App Links (owner 2026-11-27): Android checks this file to let askodox.com/v|s|p/... open the app. The
	# fingerprint is the Play app-signing certificate (public, not a secret).
	@askodox_assetlinks path /.well-known/assetlinks.json
	handle @askodox_assetlinks {
		header Content-Type application/json
		header Cache-Control "public, max-age=3600"
		respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.askodox.askodox","sha256_cert_fingerprints":["15:6C:E6:73:A0:5A:61:4F:CC:8A:BA:67:76:9A:BF:24:EF:02:C5:D9:CD:B9:2A:D3:17:C0:7D:BE:83:A5:D1:8D"]}}]` 200
	}

	# Shared video page (owner 2026-11-27): askodox.com/v/<id> = the backend's public share page.
	@askodox_video_share path /v/*
	handle @askodox_video_share {
		header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; style-src 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		header -Cache-Control
		reverse_proxy {$ASKODOX_BACKEND_URL:https://podx-ai-connect-production-3279.up.railway.app} {
			header_up Host {upstream_hostport}
		}
	}

	@askodox_picks path /p/* /shop
	handle @askodox_picks {
		header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; style-src 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		header -Cache-Control
		reverse_proxy {$ASKODOX_BACKEND_URL:https://podx-ai-connect-production-3279.up.railway.app} {
			header_up Host {upstream_hostport}
		}
	}

	# Shop links (owner 2026-11-22): askodox.com/s/<slug> = one free page per shop (menu, WhatsApp order, call, map,
	# the shop's own UPI). No script; the menu is a plain form; call / UPI taps are counted with `ping`. Same backend.
	@askodox_shop_links path /s/*
	handle @askodox_shop_links {
		header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'unsafe-inline'; script-src 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		header -Cache-Control
		reverse_proxy {$ASKODOX_BACKEND_URL:https://podx-ai-connect-production-3279.up.railway.app} {
			header_up Host {upstream_hostport}
		}
	}

	@hashed path /static/css/* /static/js/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@assets path /static/fonts/* /static/img/* /favicon.svg /favicon-32.png /apple-touch-icon.png /icon-*.png
	header @assets Cache-Control "public, max-age=604800"
	@pages not path /static/*
	header @pages Cache-Control "public, max-age=300, must-revalidate"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
